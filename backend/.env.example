# 可选：复制为 backend/.env 后生效。
# 不要在这里填写 API Key —— 密钥请在前端“系统设置”页填写，仅保存在 data/secrets.json。

# 运行数据目录（默认 backend/data）
# PPT_AGENT_DATA_DIR=C:/path/to/slidesentinel/backend/data

# 上传与页数限制
PPT_AGENT_MAX_UPLOAD_MB=80
PPT_AGENT_MAX_SLIDES=200

# 渲染长边（px）与超时（秒）
PPT_AGENT_RENDER_LONG_EDGE=1920
PPT_AGENT_RENDER_TIMEOUT=420

# 同时运行的任务数
PPT_AGENT_MAX_CONCURRENT_TASKS=2
