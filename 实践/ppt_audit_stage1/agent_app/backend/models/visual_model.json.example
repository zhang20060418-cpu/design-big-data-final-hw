  "thresholds": {
    "improper_font_sizing": 0.5,
    "occluded_content": 0.5,
    "cluttered_layout": 0.5,
    "content_overflow_cutoff": 0.5
  },
  "input_recipe": "full-slide PNG, long edge 1920, RGB"
}
