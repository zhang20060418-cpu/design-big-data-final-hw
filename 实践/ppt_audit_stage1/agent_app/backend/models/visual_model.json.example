{
  "adapter": "python_module",
  "module": "visual_model_impl",
  "callable": "predict_slide",
  "model_version": "g2-final-2026xxxx",
  "work_point": "4.3G-2 最终工作点与阈值说明",
  "labels": [
    "improper_font_sizing",
    "occluded_content",
    "cluttered_layout",
    "content_overflow_cutoff"
